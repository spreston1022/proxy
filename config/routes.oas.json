{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "AC360 MCP Proxy",
    "description": "A pass-through proxy in front of the upstream AC360 MCP server. Every request is logged with the calling app, user, and email (read from an unverified bearer JWT) plus the MCP tool name and arguments, and every response is scanned for common sensitive values (PII, financial identifiers, secrets) which are masked before reaching the calling LLM."
  },
  "paths": {
    "/mcp": {
      "post": {
        "summary": "MCP JSON-RPC endpoint",
        "description": "Forwards MCP JSON-RPC messages (initialize, tools/list, tools/call, etc.) to the upstream AC360 MCP server.",
        "operationId": "mcp-proxy-post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response from the upstream MCP server"
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.MCP_UPSTREAM_URL}"
            }
          },
          "policies": {
            "inbound": ["log-client-ip", "log-mcp-call"],
            "outbound": ["mcp-dlp-mask"]
          }
        }
      },
      "get": {
        "summary": "MCP server-sent event stream",
        "description": "Forwards the optional Streamable HTTP GET stream to the upstream AC360 MCP server.",
        "operationId": "mcp-proxy-get",
        "responses": {
          "200": {
            "description": "Server-sent event stream from the upstream MCP server"
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.MCP_UPSTREAM_URL}"
            }
          },
          "policies": {
            "inbound": ["log-client-ip", "log-mcp-call"],
            "outbound": ["mcp-dlp-mask"]
          }
        }
      },
      "delete": {
        "summary": "MCP session termination",
        "description": "Forwards session-termination requests to the upstream AC360 MCP server.",
        "operationId": "mcp-proxy-delete",
        "responses": {
          "200": {
            "description": "Response from the upstream MCP server"
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.MCP_UPSTREAM_URL}"
            }
          },
          "policies": {
            "inbound": ["log-client-ip", "log-mcp-call"],
            "outbound": ["mcp-dlp-mask"]
          }
        }
      }
    },
    "/(.*)": {
      "x-zuplo-path": {
        "pathMode": "url-pattern"
      },
      "get": {
        "summary": "Pass-through (GET)",
        "description": "Forwards any other path to the upstream AC360 server unchanged.",
        "operationId": "passthrough-get",
        "responses": {
          "200": {
            "description": "Response from the upstream server"
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.MCP_UPSTREAM_URL}"
            }
          },
          "policies": {
            "inbound": ["log-client-ip"]
          }
        }
      },
      "post": {
        "summary": "Pass-through (POST)",
        "description": "Forwards any other path to the upstream AC360 server unchanged.",
        "operationId": "passthrough-post",
        "responses": {
          "200": {
            "description": "Response from the upstream server"
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.MCP_UPSTREAM_URL}"
            }
          },
          "policies": {
            "inbound": ["log-client-ip"]
          }
        }
      },
      "put": {
        "summary": "Pass-through (PUT)",
        "description": "Forwards any other path to the upstream AC360 server unchanged.",
        "operationId": "passthrough-put",
        "responses": {
          "200": {
            "description": "Response from the upstream server"
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.MCP_UPSTREAM_URL}"
            }
          },
          "policies": {
            "inbound": ["log-client-ip"]
          }
        }
      },
      "patch": {
        "summary": "Pass-through (PATCH)",
        "description": "Forwards any other path to the upstream AC360 server unchanged.",
        "operationId": "passthrough-patch",
        "responses": {
          "200": {
            "description": "Response from the upstream server"
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.MCP_UPSTREAM_URL}"
            }
          },
          "policies": {
            "inbound": ["log-client-ip"]
          }
        }
      },
      "delete": {
        "summary": "Pass-through (DELETE)",
        "description": "Forwards any other path to the upstream AC360 server unchanged.",
        "operationId": "passthrough-delete",
        "responses": {
          "200": {
            "description": "Response from the upstream server"
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.MCP_UPSTREAM_URL}"
            }
          },
          "policies": {
            "inbound": ["log-client-ip"]
          }
        }
      },
      "head": {
        "summary": "Pass-through (HEAD)",
        "description": "Forwards any other path to the upstream AC360 server unchanged.",
        "operationId": "passthrough-head",
        "responses": {
          "200": {
            "description": "Response from the upstream server"
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.MCP_UPSTREAM_URL}"
            }
          },
          "policies": {
            "inbound": ["log-client-ip"]
          }
        }
      }
    }
  }
}
