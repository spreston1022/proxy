{
  "policies": [
    {
      "name": "log-mcp-call",
      "policyType": "log-mcp-call-inbound",
      "handler": {
        "export": "LogMcpCallInboundPolicy",
        "module": "$import(./modules/log-mcp-call)"
      }
    },
    {
      "name": "set-upstream-secret",
      "policyType": "set-headers-inbound",
      "handler": {
        "export": "SetHeadersInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "headers": [
            {
              "name": "X-Zuplo-Secret",
              "value": "$env(MCP_UPSTREAM_SECRET)",
              "overwrite": true
            }
          ]
        }
      }
    },
    {
      "name": "mcp-dlp-mask",
      "policyType": "data-loss-prevention-outbound",
      "handler": {
        "export": "DataLossPreventionOutboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "action": "mask",
          "mask": "[REDACTED]",
          "entities": ["contact", "finance", "id-us", "secret"],
          "contentTypes": ["application/json"]
        }
      }
    }
  ]
}
